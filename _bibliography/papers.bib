@article{YANG2022119,
title = {Linear Modeling and Open-loop Control of a Multi-Axis Piezoelectric Micro-Mirror for Random-Access Laser Scanning},
journal = {IFAC-PapersOnLine},
volume = {55},
number = {37},
pages = {119-124},
year = {2022},
note = {2nd Modeling, Estimation and Control Conference MECC 2022},
issn = {2405-8963},
doi = {https://doi.org/10.1016/j.ifacol.2022.11.171},
url = {https://www.sciencedirect.com/science/article/pii/S2405896322028142},
author = {Hanzhi Yang and Joonyoung Yu and Mayur B. Birla and Thomas D. Wang and Kenn R. Oldham},
keywords = {microsystems, modeling, sensors, actuators, linear systems, biomedical systems, motion, vibration control},
abstract = {This paper describes early-stage modeling of a thin-film piezoelectric microelectromechanical system (MEMS) scanning mirror capable of random-access scanning over significant range-of-motion. Due to low transduction forces, MEMS mirror technology typically relies on purely resonant operation about a neutral position, or low-bandwidth quasi-static positioning or trajectory following. High energy density of piezoelectric materials can support both high resonant frequencies and large static offsets, allowing scans to be directed in a random-access fashion to specified locations in a large field-of-view. However, this requires coordination of multiple inputs and elastic vibration modes. Here, we identify the linearized modal model for a sample piezoelectric scanner and a simple, open-loop strategy for transitions between full-field scanning and narrow-field scanning in specified regions. Influence of step-wise transition between operating modes on settling time and overshoot is characterized in simulation.}
}
